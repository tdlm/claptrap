{
  "name": "claptrap",
  "productName": "Claptrap",
  "version": "0.1.0",
  "description": "A hyperactive menu bar robot that watches what you do and writes it down in ~/Notes.",
  "main": "./out/main/index.js",
  "author": "Scott Weaver",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "npm run icons && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.107",
    "@anthropic-ai/sdk": "^0.132.0",
    "ai": "^7.0.131",
    "get-windows": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
